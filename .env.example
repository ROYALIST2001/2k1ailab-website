# ---------------------------------------------------------------------------
# Copy to `.env.local` (local dev) or `.env` (docker compose) and fill in.
# Both are gitignored. Never commit real secrets.
#
# Parsed and validated in two places:
#   NEXT_PUBLIC_*  -> apps/web/src/config/env.ts
#   everything else -> packages/infrastructure/src/config/env.ts
# ---------------------------------------------------------------------------

# Public canonical origin. Used for metadata, sitemap.xml and robots.txt.
# No trailing slash.
#
# ⚠️ Inlined into the client bundle at BUILD time. Changing it for a Docker
# deployment requires a rebuild, not just a restart — docker-compose passes it
# as a build arg for this reason.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port for the docker compose web service.
# WEB_PORT=3000

# ---------------------------------------------------------------------------
# Form delivery
# ---------------------------------------------------------------------------
# Where contact + job application submissions are delivered.
# Leave unset in development: submissions are logged to the server console
# instead of being sent, so the forms work end to end with no provider account.
# CONTACT_INBOX=hello@example.com

# When you add a real backend, point this at it. If set, submissions are
# forwarded there as JSON instead of being logged.
# See packages/infrastructure/src/submissions/ for the adapters, and
# apps/web/src/server/container.ts for where they are selected.
# BACKEND_API_URL=https://api.example.com
# BACKEND_API_KEY=
